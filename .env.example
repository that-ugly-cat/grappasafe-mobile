# Copia in `.env` (gitignored) e incolla la tua chiave.
# Google Maps SDK for Android — richiesta da react-native-maps nella build
# standalone/dev (in Expo Go non serve). Ottienila da Google Cloud Console →
# "Maps SDK for Android" → Credentials → API key.
# Per la build cloud va replicata come EAS secret con lo stesso nome:
#   npx eas-cli secret:create --scope project --name GOOGLE_MAPS_API_KEY --value <chiave>
GOOGLE_MAPS_API_KEY=
